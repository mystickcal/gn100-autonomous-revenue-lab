{
  "name": "Daily Email Digest - Free by AiMe",
  "nodes": [
    {
      "parameters": {
        "rule": "Cron Expression"
      },
      "id": "trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "list",
        "filter": {
          "read": true
        }
      },
      "id": "gmail",
      "name": "Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "messageChunks": "=Please summarize these emails into a brief digest. List the most important 5 emails.\\n\\n{{ $json.items }}\\n\\nReturn just the top 5 most important emails in a numbered list."
        }
      },
      "id": "openai",
      "name": "Summarize with AI",
      "type": "n8n-nodes-base.openai",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "content": "## Daily Email Digest\\n\\nYou have {{ $json.length }} emails. Here are the top 5 priorities:\\n\\n{{ $json.digest }}\\n\\n---\\n\\nGenerated by your n8n automation.",
        "key": "message",
        "type": "string"
      },
      "id": "telegram",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{"node": "Gmail", "type": "main", "index": 0}]]
    },
    "Gmail": {
      "main": [[{"node": "Summarize with AI", "type": "main", "index": 0}]]
    },
    "Summarize with AI": {
      "main": [[{"node": "Send to Telegram", "type": "main", "index": 0}]]
    }
  }
}
